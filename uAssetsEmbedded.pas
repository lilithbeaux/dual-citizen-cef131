var
  FEmbeddedPaths: TStringList = nil;
  FEmbeddedB64: TStringList = nil;

function EmbeddedAssetCache: TStringList;
begin
  if FEmbeddedPaths = nil then
  begin
    FEmbeddedPaths := TStringList.Create;
    FEmbeddedPaths.Sorted := True;
    FEmbeddedPaths.Duplicates := dupIgnore;
    FEmbeddedB64 := TStringList.Create;
  end;
  Result := FEmbeddedPaths;
end;

function HasEmbeddedAsset(const RelPath: string): Boolean;
begin
  Result := EmbeddedAssetCache.IndexOf(RelPath) >= 0;
end;

function EmbeddedAsset(const RelPath: string; out Content: string): Boolean;
var
  idx: Integer;
  b64: string;
begin
  Result := False;
  Content := '';
  idx := EmbeddedAssetCache.IndexOf(RelPath);
  if idx < 0 then Exit;
  b64 := FEmbeddedB64[idx];
  Content := DecodeStringBase64(b64);
  Result := True;
end;

