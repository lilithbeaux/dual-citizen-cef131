{
  "manifest_version": 3,
  "name": "Web Request Controller",
  "description": "Block and redirect web requests per account profile for privacy.",
  "version": "1.0.0",
  "icons": {
    "128": "icon.png",
    "48": "icon.png",
    "16": "icon.png"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Web Request Controller",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png"
    }
  }
}