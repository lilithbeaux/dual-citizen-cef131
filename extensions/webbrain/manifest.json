{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "48": "icons/icon48.png"
      },
      "default_title": "WebBrain"
   },
   "background": {
      "service_worker": "src/background.js",
      "type": "module"
   },
   "chrome_url_overrides": {
      "newtab": "newtab/index.html"
   },
   "commands": {
      "_execute_action": {
         "description": "Open WebBrain panel",
         "suggested_key": {
            "default": "Alt+Shift+W"
         }
      },
      "decrease-ui-scale": {
         "description": "Zoom WebBrain UI out",
         "suggested_key": {
            "default": "Alt+Shift+Comma"
         }
      },
      "increase-ui-scale": {
         "description": "Zoom WebBrain UI in",
         "suggested_key": {
            "default": "Alt+Shift+Period"
         }
      },
      "reset-ui-scale": {
         "description": "Reset WebBrain UI zoom",
         "suggested_key": {
            "default": "Alt+Shift+0"
         }
      }
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "src/content/page-monitor.js" ],
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "js": [ "src/content/page-monitor-shadow.js" ],
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_start",
      "world": "MAIN"
   }, {
      "js": [ "src/content/file-picker-guard-page.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_start",
      "world": "MAIN"
   }, {
      "js": [ "src/content/file-upload-policy.js", "src/content/rich-text-toolbar-heuristic.js", "src/content/accessibility-tree.js", "src/content/teacher-capture.js", "src/content/chat-observation.js", "src/content/content.js", "src/content/agent-visual-indicator.js", "src/content/ollama-launch-handoff.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_idle"
   }, {
      "js": [ "src/content/selection-shortcut.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "js": [ "src/content/redaction-regions.js" ],
      "match_about_blank": true,
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_idle"
   }, {
      "js": [ "src/agent/social-media-downloader.js" ],
      "matches": [ "*://*.facebook.com/*", "*://*.instagram.com/*", "*://*.x.com/*", "*://*.twitter.com/*", "*://*.linkedin.com/*", "*://*.reddit.com/*", "*://*.youtube.com/*", "*://youtu.be/*" ],
      "run_at": "document_start",
      "world": "MAIN"
   }, {
      "css": [ "src/safesocial/content.css" ],
      "js": [ "src/safesocial/content.js" ],
      "matches": [ "https://www.instagram.com/*", "https://instagram.com/*" ],
      "run_at": "document_idle"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src * data: blob:;"
   },
   "description": "Open-source AI browser agent — chat with pages, automate tasks, multi-provider LLM support.",
   "host_permissions": [ "\u003Call_urls>", "http://localhost/*", "http://127.0.0.1/*", "http://*/*" ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "mime_types_handler": {
      "application/pdf": {
         "can_embed": true,
         "handler_url": "src/ui/pdf-handler.html"
      }
   },
   "name": "WebBrain",
   "options_page": "src/ui/settings.html",
   "permissions": [ "sidePanel", "activeTab", "contextMenus", "tabs", "tabGroups", "scripting", "storage", "identity", "cookies", "notifications", "webNavigation", "webRequest", "debugger", "downloads", "alarms", "unlimitedStorage", "offscreen", "privateNetworkAccess", "tabCapture", "clipboardWrite", "clipboardRead", "search" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "45.0.4",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "src/content/autoconsent-runtime.js", "vendor/autoconsent/autoconsent.esm.js", "vendor/pdfjs/index.mjs", "vendor/pdfjs/worker.mjs", "vendor/pdfjs/compat.mjs", "vendor/pdfjs/pdf.mjs", "vendor/pdfjs/pdf.worker.mjs", "skills/*" ]
   } ]
}
