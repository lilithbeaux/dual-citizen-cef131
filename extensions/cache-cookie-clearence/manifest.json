{
  "manifest_version": 3,
  "name": "Cache Cookie Clearence",
  "description": "Clear cache, cookies, and local storage for profile resets.",
  "version": "1.0.0",
  "icons": {
    "128": "icon.png",
    "48": "icon.png",
    "16": "icon.png"
  },
  "permissions": [
    "browsingData",
    "activeTab",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Cache Cookie Clearence",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png"
    }
  }
}