{
  "manifest_version": 3,
  "name": "Header Injector",
  "description": "Inject custom HTTP headers per profile for multi-account request isolation.",
  "version": "1.0.0",
  "icons": {
    "128": "icon.png",
    "48": "icon.png",
    "16": "icon.png"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Header Injector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png"
    }
  }
}