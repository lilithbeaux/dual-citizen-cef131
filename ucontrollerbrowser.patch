+type
+  PEvalSlot = ^TEvalSlot;
+  TEvalSlot = record
+    RequestId: string;
+    Result: string;
+    Ready: Boolean;
+    StartTime: TDateTime;
+  end;
+
+procedure TControllerForm.CleanupExpiredEvalSlots;
+var
+  i: Integer;
+  slot: PEvalSlot;
+begin
+  for i := FEvalRequests.Count - 1 downto 0 do
+  begin
+    slot := PEvalSlot(FEvalRequests.Items[i]);
+    if MilliSecondsBetween(Now, slot^.StartTime) >= FEvalTimeoutMs then
+    begin
+      FEvalRequests.Delete(i);
+      // slot is auto-freed because list owns objects
+    end;
+  end;
+end;
+
+function TControllerForm.FindEvalSlot(const RequestId: string): PEvalSlot;
+var
+  idx: Integer;
+begin
+  idx := FEvalRequests.IndexOf(RequestId);
+  if idx >= 0 then
+    Result := PEvalSlot(FEvalRequests.Items[idx])
+  else
+    Result := nil;
+end;
